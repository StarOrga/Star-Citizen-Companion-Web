{
  "name": "sc-companion",
  "version": "0.81.1",
  "description": "Star Citizen companion — auth, Verse News, P4K upload analyzer.",
  "private": true,
  "type": "module",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --host 127.0.0.1 --port 4200",
    "gen:release-notes": "node scripts/gen-release-notes.js",
    "gen:readme-content": "node scripts/gen-readme-content.mjs",
    "check:readme-docs": "node scripts/gen-readme-content.mjs --check",
    "prebuild": "node scripts/gen-release-notes.js && node scripts/build-brand-icons.mjs --check && node scripts/check-csp-3d.mjs && node scripts/check-csp-connect-src.mjs && node scripts/check-no-personal-emails.mjs",
    "build": "ng build --configuration production",
    "postbuild": "node scripts/stamp-index-version.mjs && node scripts/check-index-csp.mjs && node scripts/stamp-ngsw-worker.mjs",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --watch=false --browsers=ChromeHeadless",
    "typecheck": "npx tsc --noEmit -p tsconfig.app.json",
    "verify:ship-live": "node scripts/verify-ship-live.mjs",
    "gate:mobile": "node scripts/mobile-gate.mjs",
    "gate:mobile:quick": "node scripts/mobile-gate.mjs --quick",
    "gate:mobile:auth": "node scripts/mobile-gate.mjs --auth",
    "gate:mobile:selftest": "node scripts/mobile-gate.mjs --selftest",
    "lint": "echo 'no-op: add @angular-eslint and run ng lint'",
    "stack:up": "supabase start",
    "stack:down": "supabase stop",
    "stack:status": "supabase status",
    "db:reset": "supabase db reset",
    "db:push": "supabase db push",
    "db:diff": "supabase db diff",
    "db:migration:new": "supabase migration new",
    "functions:serve": "supabase functions serve",
    "functions:deploy": "supabase functions deploy",
    "news:compact": "node --max-old-space-size=4096 scripts/news-image-compact.mjs",
    "wallpapers:dedupe": "node scripts/wallpaper-dedupe.mjs",
    "tool:dev": "npm --prefix desktop-tool run dev",
    "tool:build": "npm --prefix desktop-tool run build",
    "tool:test": "npm --prefix desktop-tool run test",
    "tool:typecheck": "npm --prefix desktop-tool run typecheck",
    "tool:package": "npm --prefix desktop-tool run package:win",
    "check:csp-3d": "node scripts/check-csp-3d.mjs",
    "check:csp-index": "node scripts/check-index-csp.mjs",
    "check:edge-functions": "node scripts/changed-edge-functions.mjs --selftest",
    "check:emails": "node scripts/check-no-personal-emails.mjs",
    "check:emails:selftest": "node scripts/check-no-personal-emails.mjs --selftest",
    "gen:brand-icons": "node scripts/build-brand-icons.mjs",
    "check:brand-icons": "node scripts/build-brand-icons.mjs --check"
  },
  "dependencies": {
    "@angular/animations": "^22.1.5",
    "@angular/cdk": "^22.1.5",
    "@angular/common": "^22.1.5",
    "@angular/compiler": "^22.1.5",
    "@angular/core": "^22.1.5",
    "@angular/forms": "^22.1.5",
    "@angular/material": "^22.1.5",
    "@angular/platform-browser": "^22.1.5",
    "@angular/router": "^22.1.5",
    "@angular/service-worker": "^22.1.5",
    "@google/model-viewer": "^4.3.1",
    "@ngx-translate/core": "^17.0.0",
    "@ngx-translate/http-loader": "^17.0.0",
    "@starorga/star-ui": "github:StarOrga/StarUI#v0.1.1",
    "@supabase/supabase-js": "^2.115.0",
    "lucide-angular": "^1.0.0",
    "modern-screenshot": "^4.7.0",
    "posthog-js": "^1.427.2",
    "rxjs": "~7.8.0",
    "three": "^0.183.2",
    "tslib": "^2.3.0",
    "zone.js": "~0.16.2"
  },
  "devDependencies": {
    "@angular/build": "^22.1.7",
    "@angular/cli": "^22.1.7",
    "@angular/compiler-cli": "^22.1.5",
    "@resvg/resvg-js": "^2.6.2",
    "@types/jasmine": "~6.0.0",
    "@types/node": "^22.0.0",
    "@types/three": "^0.183.1",
    "jasmine-core": "~5.1.0",
    "jpeg-js": "^0.4.4",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.3.0",
    "png-to-ico": "^3.0.2",
    "pngjs": "^7.0.0",
    "supabase": "^2.116.0",
    "typescript": "~5.9.0"
  },
  "overrides": {
    "@babel/core": "^7.29.1"
  }
}
