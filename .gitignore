# Python sidecar (data-uploader) — caches + embedded interpreter + real-P4K subsets
data-uploader/python/__pycache__/
data-uploader/python/**/__pycache__/
data-uploader/python/.pytest_cache/
data-uploader/python/tests/fixtures/real-subset.*
data-uploader/resources/python/
data-uploader/.cache/python-downloads/

# 3D hull/skin export — large build artifacts + fetched external build tools
# (data is 100% P4K; these are generated outputs / downloaded binaries, never commit)
