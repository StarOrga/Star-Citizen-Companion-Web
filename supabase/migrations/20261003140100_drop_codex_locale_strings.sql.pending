-- PENDING — `supabase db push` ignores this file because of its `.pending`
-- suffix (the CLI only picks up `<version>_<name>.sql`). Activate it only after
-- the web client reads locale strings from R2 (codex_builds.locale_bundles) in
-- production AND the current LIVE build has both bundles:
--
--   select id, patch_version, locale_bundles ? 'de' as de, locale_bundles ? 'en' as en
--     from public.codex_builds where is_current;
--
-- To activate: rename it with a FRESH timestamp later than every migration on
-- main at that time (a stale prefix is skipped or applied out of order), drop
-- the `.pending` suffix, then `db push`.
--
-- ALPHA-PHASE DATA POLICY: this DROPS public.codex_locale_strings with every
-- language of every build, including the nine languages the app never read.
-- The de + en strings of each build that went through locale_commit or
-- locale_backfill live on in R2 as `codex-locale/<sha>.json` shards referenced
-- by codex_builds.locale_bundles; older builds without a bundle lose their
-- locale strings (only the current build was ever read). The ingest-catalog
-- ops `locale_strings` (old uploaders) and `locale_backfill` read or write this
-- table and must be removed in the same change.
--
-- No CASCADE on purpose: if anything new came to depend on the table, the
-- drop should fail loudly instead of taking it along. Dropping frees the
-- table's files at once; no VACUUM FULL needed.

drop table if exists public.codex_locale_strings;
