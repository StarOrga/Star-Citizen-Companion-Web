{
  "name": "@sc-companion/desktop-tool",
  "version": "0.4.8",
  "description": "Star Citizen Companion (SCC) — P4K local extraction & upload tool.",
  "private": true,
  "main": "out/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "icon": "node scripts/build-icon.js",
    "python:fetch": "node scripts/fetch-embedded-python.js",
    "package:win": "npm run icon && npm run python:fetch && electron-vite build && electron-builder --win --x64 --config electron-builder.yml",
    "package:dir": "npm run icon && npm run python:fetch && electron-vite build && electron-builder --dir --config electron-builder.yml"
  },
  "dependencies": {
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.3",
    "yauzl": "^3.1.3"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^22.0.0",
    "@types/yauzl": "^2.10.3",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.7",
    "electron-vite": "^2.3.0",
    "png-to-ico": "^3.0.1",
    "typescript": "~5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.4"
  },
  "engines": {
    "node": ">=20.10.0"
  }
}
