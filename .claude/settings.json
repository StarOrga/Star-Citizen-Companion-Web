{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm:*)",
      "Bash(npx:*)",
      "Bash(ng:*)",
      "Bash(git:*)",
      "Bash(gh:*)",
      "Bash(node:*)",
      "Bash(ls:*)",
      "Bash(pwd)",
      "Bash(cat:*)",
      "Bash(echo:*)",
      "Bash(date:*)"
    ],
    "deny": []
  },
  "env": {
    "FORCE_COLOR": "1",
    "NG_CLI_ANALYTICS": "false",
    "PLAYWRIGHT_MCP_INIT_PAGE": "scripts/playwright/test-session.cjs",
    "PLAYWRIGHT_MCP_ISOLATED": "true"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/pre.ask.unattended.mjs\""
          }
        ]
      }
    ]
  }
}
