{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "resources": {
        "files": [
          "/favicon.ico",
          "/index.html",
          "/manifest.webmanifest",
          "/*.css",
          "/*.js",
          "!/chunk-*.js"
        ]
      }
    },
    {
      "name": "chunks",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/chunk-*.js"
        ]
      }
    },
    {
      "name": "assets",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/icons/**",
          "/i18n/*.json",
          "/meshopt/**",
          "/planet/**",
          "/release-notes.json",
          "/*.(svg|cur|jpg|jpeg|png|apng|webp|avif|gif|otf|ttf|woff|woff2)"
        ]
      }
    }
  ],
  "dataGroups": [
    {
      "name": "verse-news",
      "urls": [
        "https://hcnqhvzlavdycidqyaai.supabase.co/functions/v1/fetch-verse-news"
      ],
      "cacheConfig": {
        "maxSize": 50,
        "maxAge": "15m",
        "timeout": "4s",
        "strategy": "freshness"
      }
    },
    {
      "name": "rsi-upcoming-ships",
      "urls": [
        "https://hcnqhvzlavdycidqyaai.supabase.co/functions/v1/rsi-upcoming-ships"
      ],
      "cacheConfig": {
        "maxSize": 4,
        "maxAge": "6h",
        "timeout": "4s",
        "strategy": "freshness"
      }
    },
    {
      "name": "verse-digest",
      "urls": [
        "https://hcnqhvzlavdycidqyaai.supabase.co/rest/v1/rpc/verse_digest",
        "https://hcnqhvzlavdycidqyaai.supabase.co/rest/v1/rpc/verse_digest?*"
      ],
      "cacheConfig": {
        "maxSize": 2,
        "maxAge": "60s",
        "timeout": "5s",
        "strategy": "freshness"
      }
    }
  ]
}
