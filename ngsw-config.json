{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "resources": {
        "files": ["/favicon.ico", "/index.html", "/manifest.webmanifest", "/*.css", "/*.js"]
      }
    },
    {
      "name": "assets",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": ["/assets/**", "/*.(svg|cur|jpg|jpeg|png|apng|webp|avif|gif|otf|ttf|woff|woff2)"]
      }
    }
  ],
  "dataGroups": [
    {
      "name": "verse-news",
      "urls": ["https://hcnqhvzlavdycidqyaai.supabase.co/functions/v1/fetch-verse-news"],
      "cacheConfig": {
        "maxSize": 50,
        "maxAge": "15m",
        "timeout": "10s",
        "strategy": "freshness"
      }
    },
    {
      "name": "rsi-upcoming-ships",
      "urls": ["https://hcnqhvzlavdycidqyaai.supabase.co/functions/v1/rsi-upcoming-ships"],
      "cacheConfig": {
        "maxSize": 4,
        "maxAge": "6h",
        "timeout": "10s",
        "strategy": "freshness"
      }
    }
  ]
}
