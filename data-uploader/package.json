{
  "name": "@sc-companion/data-uploader",
  "version": "0.23.0",
  "description": "Star Citizen Companion - Data Uploader — P4K local extraction & upload tool.",
  "private": true,
  "main": "out/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "icon": "node scripts/build-icon.js",
    "python:fetch": "node scripts/fetch-embedded-python.js",
    "package:win": "npm run icon && npm run python:fetch && electron-vite build && electron-builder --win --x64 --config electron-builder.yml",
    "package:dir": "npm run icon && npm run python:fetch && electron-vite build && electron-builder --dir --config electron-builder.yml"
  },
  "dependencies": {
    "@gltf-transform/cli": "^4.4.2",
    "@starorga/star-ui": "github:StarOrga/StarUI#v0.1.1",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.9",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^26.1.2",
    "@types/yauzl": "^3.4.0",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "png-to-ico": "^3.0.2",
    "typescript": "~7.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=20.10.0"
  },
  "overrides": {
    "esbuild": "^0.25.0",
    "@noble/hashes": "^1.8.0"
  }
}
